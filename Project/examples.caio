cd ../../ -> 
Command + arguments -> arguments = filespaths, options (-x, --aa arguments)

COMMAND         = IDENT
ARGS       = []
             IDENT ARGS
             VAR ARGS
             PIPE COMMAND ARGS
             
env x ".." | ls x


EXPR    = COMMAND ARGUMENTS PIPE COMMAND ARGUMENTS
        = COMMAND ARGUMENTS
        = OPERATIONS 
        
LOOP    = FOR VAR IN ITERATIONS THEN EXPR 
        = WHILE EXPR IS BOOL THEN EXPR 

ITERATIONS =    LIST 
                RANGE
                RANGE EXCEPT LIST

VAR =   FILEPATH
        INT
        STRING
        BOOL

IF EXPR THEN EXPR  
IF EXPR THEN EXPR ESLE EXPR 

EXPR PIPE EXPR 



